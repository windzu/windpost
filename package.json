{
  "name": "obsidian-windpost",
  "version": "1.0.3",
  "description": "Publish the current Obsidian note to Blog and WeChat.",
  "main": "main.js",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "tsx --test tests/*.test.cjs tests/*.test.ts",
    "lint": "eslint .",
    "release:check": "node scripts/check-release.cjs",
    "check": "pnpm lint && pnpm test && pnpm build && pnpm audit --prod --audit-level high && pnpm release:check"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "blog",
    "wechat"
  ],
  "author": "windzu",
  "license": "MIT",
  "dependencies": {
    "highlight.js": "^11.11.1",
    "juice": "^12.1.2",
    "katex": "^0.16.27",
    "lucide-react": "^0.562.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-external-links": "^3.0.0",
    "rehype-github-alert": "^1.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "smol-toml": "^1.6.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "0.24.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.9.0",
    "obsidian": "latest",
    "tslib": "2.7.0",
    "tsx": "^4.20.6",
    "typescript": "5.5.4",
    "typescript-eslint": "^8.66.0"
  }
}
